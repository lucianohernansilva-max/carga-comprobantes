{
  "manifest_version": 3,
  "name": "Vencimientos — Estudio Silva",
  "version": "1.0",
  "description": "Próximos vencimientos impositivos del estudio contable",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://localhost:5173/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
